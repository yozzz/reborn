#!/bin/sh
# reborn: bring Claude Code background sessions back after a reboot.
set -eu

VERSION=0.2.1
CONFIG_DIR=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
ROSTER=${REBORN_ROSTER:-$CONFIG_DIR/daemon/roster.json}
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/reborn
CLAUDE=${REBORN_CLAUDE:-claude}
LABEL=local.reborn
PLIST=$HOME/Library/LaunchAgents/$LABEL.plist
LOG=$HOME/Library/Logs/reborn.log

die() { printf 'reborn: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
usage: reborn restore [--dry-run] [--tabs]   resume the background sessions a reboot left behind
       reborn tabs [id...]                   open each running background session in an iTerm tab
       reborn install [--tabs]               run 'reborn restore' at every login (macOS)
       reborn uninstall                      remove the login item
EOF
}

squeeze() { awk '{$1=$1; print}'; }

# A pid alone proves nothing after a reboot, because pids get reused,
# so a worker only counts as running if its start time matches too.
# Claude records that time in UTC; local time is accepted as well.
running() {
  want=$(printf '%s\n' "$2" | squeeze)
  utc=$(TZ=UTC LC_ALL=C ps -p "$1" -o lstart= 2>/dev/null | squeeze)
  here=$(LC_ALL=C ps -p "$1" -o lstart= 2>/dev/null | squeeze)
  [ -n "$want" ] && [ -n "$utc" ] && { [ "$utc" = "$want" ] || [ "$here" = "$want" ]; }
}

service_running() {
  [ -f "$CONFIG_DIR/daemon.status.json" ] || return 1
  eval "set -- $(jq -r '[(.supervisorPid // 0), (.supervisorProcStart // "")] | @sh' "$CONFIG_DIR/daemon.status.json")"
  running "$1" "$2"
}

restore() {
  dry=
  [ "${1:-}" = --dry-run ] && dry=1
  command -v jq >/dev/null 2>&1 || die "jq is required"
  echo "reborn restore $(date '+%Y-%m-%d %H:%M:%S')"
  [ -f "$ROSTER" ] || { echo "no roster at $ROSTER, nothing to restore"; return 0; }

  # Read every worker before resuming any: the first 'claude --bg' starts
  # Claude's background service, which clears dead workers from the roster.
  workers=$(jq -r '(.workers // {})[]
    | select(.sessionId and .cwd)
    | [(.pid // 0), (.procStart // ""), .cwd, .sessionId] + (.dispatch.respawnFlags // [])
    | @sh' "$ROSTER") || die "cannot read $ROSTER"
  [ -n "$workers" ] || { echo "roster is empty, nothing to restore"; return 0; }

  [ -n "$dry" ] || { mkdir -p "$STATE_DIR" && cp "$ROSTER" "$STATE_DIR/last-roster.json"; }

  # Start Claude's background service before resuming anything. A service that
  # starts because of a resume still lists that session's dead worker for a
  # moment, and resumes it as a copy instead. With nothing running yet,
  # respawn has nothing to restart; it only starts the service.
  if [ -z "$dry" ] && ! service_running; then
    "$CLAUDE" respawn --all </dev/null >/dev/null 2>&1 || true
  fi

  printf '%s\n' "$workers" | while IFS= read -r line; do
    eval "set -- $line"
    pid=$1 started=$2 dir=$3 session=$4
    shift 4
    if running "$pid" "$started"; then
      echo "running   $session  $dir"
    elif [ ! -d "$dir" ]; then
      echo "skipped   $session  $dir (folder no longer exists)"
    elif [ -n "$dry" ]; then
      echo "would resume  $session  $dir"
    else
      # </dev/null: claude must not read the rest of the session list.
      out=$(cd "$dir" && "$CLAUDE" --bg --resume "$session" "$@" </dev/null 2>&1) || true
      if printf '%s\n' "$out" | grep -qi 'copy'; then
        echo "copied    $session  $dir: $(printf '%s\n' "$out" | grep -i 'copy' | head -1)"
      elif printf '%s\n' "$out" | grep -q 'backgrounded'; then
        echo "resumed   $session  $dir"
      else
        echo "failed    $session  $dir: $(printf '%s\n' "$out" | grep -v 'Starting background service' | head -1)"
      fi
    fi
  done
}

# One tab per session, each attached to it, in the current iTerm window (or a
# new one if none is open). The tabs start from a normal shell, so detaching
# leaves you in the session's folder.
open_tabs() {
  [ "$(uname)" = Darwin ] || die "tabs needs macOS and iTerm"
  sessions=$("$CLAUDE" agents --json 2>/dev/null | jq -r --arg want "$*" '.[]
    | select(.kind == "background")
    | select($want == "" or (.id as $i | $want | split(" ") | index($i)))
    | .cwd, .id') || die "cannot list sessions"
  [ -n "$sessions" ] || { echo "no background sessions to open"; return 0; }
  old_ifs=$IFS; IFS='
'
  set -f; set -- $sessions; set +f
  IFS=$old_ifs
  osascript - "$@" >/dev/null <<'APPLESCRIPT' \
    || die "could not open iTerm tabs; allow control of iTerm in System Settings > Privacy & Security > Automation, then run 'reborn tabs'"
on run argv
  set wasRunning to application "iTerm" is running
  tell application "iTerm"
    activate
    if not wasRunning then delay 2
    if (count of windows) is 0 then
      set w to (create window with default profile)
      set useFirstTab to true
    else
      set w to current window
      set useFirstTab to false
    end if
    repeat with k from 1 to (count of argv) by 2
      if k > 1 or not useFirstTab then tell w to create tab with default profile
      tell current session of w to write text "cd " & quoted form of (item k of argv) & " && claude attach " & (item (k + 1) of argv)
    end repeat
  end tell
end run
APPLESCRIPT
  echo "opened $(($# / 2)) tab(s) in iTerm"
}

install_agent() {
  [ "$(uname)" = Darwin ] || die "install only supports macOS so far"
  cmd=restore
  [ "${1:-}" = --tabs ] && cmd="restore --tabs"
  self=$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")
  shell=${SHELL:-/bin/zsh}
  mkdir -p "$(dirname "$PLIST")" "$(dirname "$LOG")"
  # Run through an interactive login shell so the background service, and every
  # session it starts, gets the same environment as a terminal.
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$shell</string>
    <string>-lic</string>
    <string>exec '$self' $cmd</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$LOG</string>
  <key>StandardErrorPath</key>
  <string>$LOG</string>
</dict>
</plist>
EOF
  plutil -lint "$PLIST" >/dev/null || die "wrote an invalid $PLIST"
  echo "installed $PLIST"
  echo "reborn $cmd will run at every login; log: $LOG"
}

uninstall_agent() {
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  rm -f "$PLIST"
  echo "removed $PLIST"
}

case ${1:-} in
  restore)
    shift; dry= tabs=
    for arg in "$@"; do
      case $arg in
        --dry-run) dry=1 ;;
        --tabs) tabs=1 ;;
        *) usage >&2; exit 2 ;;
      esac
    done
    restore ${dry:+--dry-run}
    if [ -n "$tabs" ] && [ -z "$dry" ]; then sleep 2; open_tabs; fi ;;
  tabs) shift; open_tabs "$@" ;;
  install) shift; install_agent "$@" ;;
  uninstall) uninstall_agent ;;
  --version) echo "reborn $VERSION" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
