#!/bin/sh
# reborn: reopen your Claude Code tabs after a restart.
set -eu

VERSION=0.3.1
CONFIG_DIR=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
ROSTER=$CONFIG_DIR/daemon/roster.json
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/reborn
OPEN=$STATE_DIR/open-tabs.tsv
CLAUDE=${REBORN_CLAUDE:-claude}
LABEL=local.reborn
SNAP_LABEL=local.reborn.snapshot
AGENTS=$HOME/Library/LaunchAgents
LOG=$HOME/Library/Logs/reborn.log
# A session that disappears stays remembered this long: a shutdown closes every
# tab at once, and the list has to survive that.
KEEP_SECONDS=150
TAB=$(printf '\t')

die() { printf 'reborn: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
usage: reborn status      show the Claude tabs that would come back after a restart
       reborn restore     reopen them in iTerm (runs at login)
       reborn snapshot    remember which Claude tabs are open (runs every minute)
       reborn install     set up both login items (macOS)
       reborn uninstall   remove them
EOF
}

squeeze() { awk '{$1=$1; print}'; }

# A pid alone proves nothing after a reboot, because pids get reused,
# so a process only counts as running if its start time matches too.
# Claude records that time in UTC; local time is accepted as well.
running() {
  want=$(printf '%s\n' "$2" | squeeze)
  utc=$(TZ=UTC LC_ALL=C ps -p "$1" -o lstart= 2>/dev/null | squeeze)
  here=$(LC_ALL=C ps -p "$1" -o lstart= 2>/dev/null | squeeze)
  [ -n "$want" ] && [ -n "$utc" ] && { [ "$utc" = "$want" ] || [ "$here" = "$want" ]; }
}

boot_time() {
  if [ -n "${REBORN_BOOT_TIME:-}" ]; then echo "$REBORN_BOOT_TIME"; return; fi
  sysctl -n kern.boottime | sed -E 's/^\{ sec = ([0-9]+),.*/\1/'
}

service_running() {
  [ -f "$CONFIG_DIR/daemon.status.json" ] || return 1
  eval "set -- $(jq -r '[(.supervisorPid // 0), (.supervisorProcStart // "")] | @sh' "$CONFIG_DIR/daemon.status.json")"
  running "$1" "$2"
}

# One line per Claude session open in a terminal right now:
# kind, session id, short id, folder, name.
current_sessions() {
  for f in "$CONFIG_DIR"/sessions/*.json; do
    [ -f "$f" ] || continue
    jq -r 'select(.kind == "interactive" and (.entrypoint // "cli") == "cli")
      | [(.pid // 0), (.procStart // ""), .sessionId, .cwd, (.name // "")] | @sh' "$f" </dev/null 2>/dev/null || true
  done | while IFS= read -r line; do
    eval "set -- $line"
    if running "$1" "$2"; then
      printf 'resume\t%s\t%s\t%s\t%s\n' "$3" "$(printf '%s' "$3" | cut -c1-8)" "$4" "$5"
    fi
  done
  # Tabs showing a background session through `claude attach <id>`.
  [ -f "$ROSTER" ] || return 0
  ps -axo command= | sed -n 's/.*claude attach \([0-9a-f]\{8\}\).*/\1/p' | sort -u | while IFS= read -r id; do
    name=$(jq -r '.name // empty' "$CONFIG_DIR/jobs/$id/state.json" </dev/null 2>/dev/null || true)
    jq -r --arg id "$id" --arg name "$name" \
      '.workers[$id] // empty | ["attach", .sessionId, $id, .cwd, $name] | @tsv' "$ROSTER" </dev/null
  done
}

# The list is: last seen, kind, session id, short id, folder, name.
snapshot() {
  mkdir -p "$STATE_DIR"
  now=$(date +%s)
  boot=$(boot_time)
  tmp=$(mktemp "$STATE_DIR/.open.XXXXXX")
  {
    current_sessions | awk -v now="$now" 'BEGIN { FS = OFS = "\t" } { print now, $0 }'
    [ -f "$OPEN" ] && cat "$OPEN"
  } | awk -v now="$now" -v boot="$boot" -v keep="$KEEP_SECONDS" 'BEGIN { FS = OFS = "\t" }
    seen[$3]++ { next }
    $1 == now || $1 < boot || now - $1 < keep' > "$tmp"
  mv "$tmp" "$OPEN"
}

status() {
  [ -s "$OPEN" ] || { echo "no Claude tabs remembered yet"; return 0; }
  echo "after a restart, these tabs come back:"
  awk 'BEGIN { FS = "\t" } { printf "  %s  %-34s %s\n", $4, ($6 == "" ? "-" : $6), $5 }' "$OPEN" | sed "s#$HOME#~#"
}

# The tty of every iTerm tab, in window and tab order. Starts iTerm if needed
# and gives it a moment to restore its own windows.
iterm_ttys() {
  osascript <<'APPLESCRIPT'
set wasRunning to application "iTerm" is running
tell application "iTerm"
  activate
  if not wasRunning then delay 3
  set out to ""
  repeat with w in windows
    repeat with t in tabs of w
      set out to out & (tty of current session of t) & linefeed
    end repeat
  end repeat
  return out
end tell
APPLESCRIPT
}

# Tabs with nothing but a shell in them, such as the empty ones iTerm
# restores after a restart.
idle_ttys() {
  iterm_ttys | while IFS= read -r tty; do
    [ -n "$tty" ] || continue
    busy=$(ps -t "${tty#/dev/}" -o comm= 2>/dev/null | grep -cvE '(^|/)-?(zsh|bash|sh|fish|login)$' || true)
    [ "$busy" -eq 0 ] && echo "$tty"
  done
}

# Arguments are folder/command pairs. Each goes into an empty tab while there
# are any, then into new tabs in the current iTerm window (or a new window).
open_tabs() {
  idle=$(idle_ttys)
  pairs=$(($# / 2))
  i=0
  while [ "$i" -lt "$pairs" ]; do
    dir=$1 cmd=$2
    shift 2
    set -- "$@" "$(printf '%s\n' "$idle" | sed -n "$((i + 1))p")" "$dir" "$cmd"
    i=$((i + 1))
  done
  osascript - "$@" >/dev/null <<'APPLESCRIPT' \
    || die "could not open iTerm tabs; allow control of iTerm in System Settings > Privacy & Security > Automation, then run 'reborn restore'"
on run argv
  tell application "iTerm"
    activate
    repeat with k from 1 to (count of argv) by 3
      set target to item k of argv
      set s to missing value
      if target is not "" then
        repeat with w in windows
          repeat with t in tabs of w
            if tty of current session of t is target then set s to current session of t
          end repeat
        end repeat
      end if
      if s is missing value then
        if (count of windows) is 0 then
          set w to (create window with default profile)
        else
          set w to current window
          tell w to create tab with default profile
        end if
        set s to current session of w
      end if
      tell s to write text "cd " & quoted form of (item (k + 1) of argv) & " && " & (item (k + 2) of argv)
    end repeat
  end tell
end run
APPLESCRIPT
  reused=$(printf '%s\n' "$idle" | grep -c . || true)
  [ "$reused" -gt "$pairs" ] && reused=$pairs
  echo "opened $pairs tab(s) in iTerm, $reused of them in empty tabs"
}

restore() {
  echo "reborn restore $(date '+%Y-%m-%d %H:%M:%S')"
  [ -s "$OPEN" ] || { echo "no remembered tabs"; return 0; }
  boot=$(boot_time)
  todo=$(awk -v boot="$boot" 'BEGIN { FS = "\t" } $1 < boot' "$OPEN")
  [ -n "$todo" ] || { echo "nothing was open before this restart"; return 0; }
  open_now=$(current_sessions | cut -f2)
  set --
  attach=
  while IFS="$TAB" read -r _seen kind session short dir _name; do
    if printf '%s\n' "$open_now" | grep -qx "$session"; then
      echo "open      $short  $dir"
    elif [ ! -d "$dir" ]; then
      echo "skipped   $short  $dir (folder no longer exists)"
    elif [ "$kind" = attach ]; then
      set -- "$@" "$dir" "claude attach $short"
      attach=1
      echo "reopening $short  $dir"
    else
      set -- "$@" "$dir" "claude --resume $session"
      echo "reopening $short  $dir"
    fi
  done <<EOF
$todo
EOF
  if [ $# -gt 0 ]; then
    # Attaching revives a background session. Start Claude's background service
    # first, so it has cleared the dead sessions and doesn't resume copies.
    if [ -n "$attach" ] && ! service_running; then
      "$CLAUDE" respawn --all </dev/null >/dev/null 2>&1 || true
    fi
    open_tabs "$@"
  fi
  # Handled; from here on the snapshot tracks what's open again.
  cp "$OPEN" "$STATE_DIR/last-restore.tsv"
  tmp=$(mktemp "$STATE_DIR/.open.XXXXXX")
  awk -v boot="$boot" 'BEGIN { FS = OFS = "\t" } $1 >= boot' "$OPEN" > "$tmp"
  mv "$tmp" "$OPEN"
}

install_agent() {
  [ "$(uname)" = Darwin ] || die "install only supports macOS so far"
  self=$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")
  shell=${SHELL:-/bin/zsh}
  uid=$(id -u)
  mkdir -p "$AGENTS" "$(dirname "$LOG")" "$STATE_DIR"
  # Restore runs through an interactive login shell, so it finds claude and
  # jq the way a terminal does.
  cat > "$AGENTS/$LABEL.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$shell</string>
    <string>-lic</string>
    <string>exec '$self' restore</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$LOG</string>
  <key>StandardErrorPath</key>
  <string>$LOG</string>
</dict>
</plist>
EOF
  cat > "$AGENTS/$SNAP_LABEL.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$SNAP_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$self</string>
    <string>snapshot</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>$LOG</string>
</dict>
</plist>
EOF
  for p in "$AGENTS/$LABEL.plist" "$AGENTS/$SNAP_LABEL.plist"; do
    plutil -lint "$p" >/dev/null || die "wrote an invalid $p"
  done
  # Start remembering tabs now rather than from the next login.
  launchctl bootout "gui/$uid/$SNAP_LABEL" 2>/dev/null || true
  launchctl bootstrap "gui/$uid" "$AGENTS/$SNAP_LABEL.plist"
  "$self" snapshot
  echo "installed: open Claude tabs are remembered every minute and reopened at login"
  echo "log: $LOG"
}

uninstall_agent() {
  uid=$(id -u)
  for l in "$LABEL" "$SNAP_LABEL"; do
    launchctl bootout "gui/$uid/$l" 2>/dev/null || true
    rm -f "$AGENTS/$l.plist"
  done
  echo "removed both login items"
}

case ${1:-} in
  status) status ;;
  restore) restore ;;
  snapshot) snapshot ;;
  install) install_agent ;;
  uninstall) uninstall_agent ;;
  --version) echo "reborn $VERSION" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
